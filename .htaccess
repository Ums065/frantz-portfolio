# Project root entry point for Apache.
# This serves the built React app from frontend/dist while leaving /api
# requests to the PHP router in api/.

Options -Indexes

# Security (defense in depth): never serve dotfiles or raw config / database /
# backup files anywhere under the web root. api/.htaccess repeats this for the
# API directory. Apache 2.4 syntax.
<FilesMatch "(^\.|\.(env|ini|log|sql|sqlite|db|bak|old|orig|swp|sh)$)">
    Require all denied
</FilesMatch>

# M-4: HTTP security headers (hardening). CSP is intentionally framing-only so it
# cannot break the Razorpay/Stripe/PayPal checkout scripts; a full script-src CSP
# would need to allowlist those providers first.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # HSTS is honored by browsers only over HTTPS (ignored over plain HTTP), so
  # setting it unconditionally is safe and takes effect once the site is on TLS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Only the real domain may appear in Google. A staging or test copy of this site
# (any other hostname) tells search engines not to index it: Google had been
# ranking the staging copy and sending it clicks that belong to the live site.
# noindex is deliberately used instead of a robots.txt "Disallow": a blocked
# URL cannot be crawled, so Google would never see the noindex and the URL
# would linger in the index. Localhost is left alone.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^(www\.)?frantzcoutard\.com(:[0-9]+)?$" FC_PRODUCTION_HOST
  SetEnvIfNoCase Host "^(localhost|127\.0\.0\.1)(:[0-9]+)?$" FC_PRODUCTION_HOST
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=!FC_PRODUCTION_HOST
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address per page: www.frantzcoutard.com and frantzcoutard.com count as
  # two copies of the site to Google. Send www to the bare domain, straight to
  # https, in a single hop (before the HTTPS rule below, which would otherwise
  # add a second one).
  RewriteCond %{HTTP_HOST} ^www\.frantzcoutard\.com$ [NC]
  RewriteRule ^ https://frantzcoutard.com%{REQUEST_URI} [R=301,L]

  # M-5: force HTTPS in production. Skips localhost / 127.0.0.1 so local WAMP
  # HTTP development is not redirected.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !=localhost
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Root URL should open the built SPA.
  RewriteRule ^$ frontend/dist/index.html [L]

  # Leave the API alone so api/.htaccess can route it to index.php.
  RewriteRule ^api(/.*)?$ - [L]

  # Dynamic sitemap: /sitemap.xml is generated by sitemap.php (static pages +
  # live blog posts). Must come before the "serve real dist files" rule below,
  # otherwise the stale static frontend/dist/sitemap.xml would win.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # /partner is now the dynamic React page (falls through to the SPA below).
  # /player keeps serving the static Our Partners snapshot from the build.
  RewriteRule ^player/?$ frontend/dist/partner.html [L]

  # Serve build assets from frontend/dist.
  RewriteRule ^assets/(.*)$ frontend/dist/assets/$1 [L]

  # Serve any real file that lives inside the build at the web root
  # (sitemap.xml, robots.txt, favicon, manifest, docs/*, …) — otherwise
  # the SPA fallback below would hand back index.html (HTML) for them,
  # which is why Google Search Console said "Couldn't fetch" the sitemap.
  RewriteCond %{DOCUMENT_ROOT}/frontend/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ frontend/dist/$1 [L]

  # Serve real files and folders as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for client-side routes. Served through spa.php, which injects
  # the correct per-route <title>/description/OG tags for social scrapers and
  # crawlers, then falls back to the untouched index.html on any error.
  RewriteRule ^ spa.php [L]
</IfModule>
